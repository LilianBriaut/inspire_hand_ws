Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /TactileCloud1
      Splitter Ratio: 0.5
    Tree Height: 800
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description File: ""
      Description Topic:
        Value: /rh56dftp/left/robot_description
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.6
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Axes: true
      Show Arrows: false

    - Class: rviz_default_plugins/PointCloud2
      Name: TactileCloud
      Enabled: true
      Topic:
        Value: /rh56dftp/tactile/left/cloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.0015
      Color Transformer: RGB8
      Alpha: 1.0
      Decay Time: 0

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: left_hand_root
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1800
  X: 0
  Y: 0
